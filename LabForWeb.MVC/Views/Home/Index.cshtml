@using LabForWeb.MVC.Models
@model IEnumerable<ProdottiGalleryPartialModel>

@{
    ViewData["Title"] = "Home Page";
}

<div class="text-center">
    <h1 class="display-4">Amazon pugliese</h1>
</div>

@foreach (var gallery in Model.Select((value, index) => new { Valore = value, Indice = index }))
{
    <partial name="_ProdottiGalleryPartial" model="@gallery.Valore" />
    @if (gallery.Indice < Model.Count() - 1)
    {
        <hr />
    }
}
