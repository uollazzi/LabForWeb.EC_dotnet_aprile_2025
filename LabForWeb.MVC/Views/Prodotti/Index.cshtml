@model List<ProdottoModel>

@{
    ViewData["Messaggio"] = ViewData["Messaggio"].ToString().ToUpper();
    ViewData["Contatore"] = 67 * 9;
}

<h1>Elenco Prodotti</h1>
@* <p class="rosso">@ViewData["Messaggio"]</p>
<p>@ViewData["Contatore"]</p> *@
<a class="btn btn-primary" asp-action="Create">Insierisci nuovo prodotto</a>
<hr />

@if (Model.Count == 0)
{
    <p>Il database non contiene attualmente prodotti</p>
}
else
{
    <ul class="list-group">
        @foreach (var p in Model)
        {
            <li class="list-group-item @(p.Giacenza == 0 ? "rosso" : "")">@p.Nome</li>            
        }
    </ul>
}
<hr />
@* HTML HELPERS *@
@Html.ActionLink("Vai qui", "Privacy", "Home", htmlAttributes: new { @alt = "Ciao" })